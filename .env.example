# Firebase public config (vai pro bundle client; restringido por authorized domains)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# App Check (reCAPTCHA v3). Site key é pública — em HML/PRD vem do apphosting*.yaml;
# aqui só precisa preencher pra testar App Check em dev. Vazia = App Check off.
NEXT_PUBLIC_FIREBASE_APPCHECK_RECAPTCHA_V3_SITE_KEY=
# Debug token pra rodar /auth/action em localhost sem passar no reCAPTCHA. Gere/registre
# em Firebase Console → App Check → Apps → Manage debug tokens e cole aqui.
# SÓ dev (.env.local, gitignored) — NUNCA commitar nem usar em produção.
NEXT_PUBLIC_FIREBASE_APPCHECK_DEBUG_TOKEN=

# URL base do site público (usado em sitemap/canonical/OG/JSON-LD)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only: Application Default Credentials em App Hosting; em dev, aponte pro JSON local
GOOGLE_APPLICATION_CREDENTIALS=

# Webhook do backoffice → /api/revalidate (HMAC-SHA256)
REVALIDATE_SECRET=

# Google Search Console verification (meta tag no <head>)
GOOGLE_SITE_VERIFICATION=

# IndexNow key (Bing/Yandex/etc.) — opcional, usado pelo backoffice
INDEXNOW_KEY=

# Analytics de terceiros (opcionais; só carregam quando setados — hoje só em prod)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_CLARITY_ID=
